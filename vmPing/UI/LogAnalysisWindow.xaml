<Window x:Class="vmPing.UI.LogAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:classes="clr-namespace:vmPing.Classes"
        UseLayoutRounding="True"
        Title="日志分析"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#f5f6f8"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <classes:RttToColorConverter x:Key="RttToColorConverter"/>
            <Style TargetType="DataGridCell">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#3b82f6"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#3b82f6"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <hc:LoadingCircle Width="48" Height="48" Foreground="White"/>
                <TextBlock Text="查询中..." Foreground="White" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <DockPanel>
            <Border DockPanel.Dock="Top" Background="White" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="日志分析" FontSize="20" FontWeight="Bold" Foreground="#1f2937" VerticalAlignment="Center"/>
                        <TextBlock Name="HeaderSubtitle" Text="" FontSize="12" Foreground="#9ca3af" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" Style="{StaticResource ButtonPrimary}" Padding="16,6" Margin="0,0,8,0"/>
                        <Button Name="ExportButton" Content="导出 CSV" Click="ExportButton_Click" Style="{StaticResource ButtonDefault}" Padding="16,6" Margin="0,0,8,0"/>
                        <Button Name="ClearButton" Content="清除记录" Click="ClearButton_Click" Style="{StaticResource ButtonDefault}" Padding="16,6"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="White" Padding="16,8" BorderBrush="#e5e7eb" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="主机" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4b5563"/>
                    <ComboBox Name="HostSelector" DisplayMemberPath="DisplayName" SelectionChanged="HostSelector_SelectionChanged" MinWidth="200" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="从" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4b5563"/>
                    <DatePicker Name="FromDatePicker" Width="140" SelectedDateFormat="Short" VerticalAlignment="Center"/>
                    <TextBlock Text="到" FontSize="13" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#4b5563"/>
                    <DatePicker Name="ToDatePicker" Width="140" SelectedDateFormat="Short" VerticalAlignment="Center"/>
                    <Button Name="QueryButton" Content="查询" Click="QueryButton_Click" Style="{StaticResource ButtonPrimary}" Padding="16,6" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton Name="Quick1h" Content="1小时" Click="QuickTime_Click" Tag="1" Margin="0,0,8,0" Foreground="#6b7280"/>
                        <RadioButton Name="Quick24h" Content="24小时" Click="QuickTime_Click" Tag="24" IsChecked="True" Margin="0,0,8,0" Foreground="#6b7280"/>
                        <RadioButton Name="Quick7d" Content="7天" Click="QuickTime_Click" Tag="168" Margin="0,0,8,0" Foreground="#6b7280"/>
                        <RadioButton Name="Quick30d" Content="30天" Click="QuickTime_Click" Tag="720" Foreground="#6b7280"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#1f2937" Padding="16,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="StatusHosts" Text="● 0 台主机" Foreground="#9ca3af" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Name="StatusRecords" Text="● 0 条记录" Foreground="#9ca3af" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Name="StatusQueryTime" Text="" Foreground="#9ca3af" FontSize="12"/>
                </StackPanel>
            </Border>

            <TabControl Name="MainTabs" TabStripPlacement="Left" Background="White" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="概览" FontSize="14" Padding="16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <UniformGrid Columns="5" Margin="0,0,0,16">
                                <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="主机数" Foreground="#6b7280" FontSize="12"/>
                                        <TextBlock Name="CardHostCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1f2937"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="记录总数" Foreground="#6b7280" FontSize="12"/>
                                        <TextBlock Name="CardTotalRecords" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1f2937"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="平均延迟" Foreground="#6b7280" FontSize="12"/>
                                        <TextBlock Name="CardAvgRtt" Text="0 ms" FontSize="28" FontWeight="Bold" Foreground="#1f2937"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="丢包率" Foreground="#6b7280" FontSize="12"/>
                                        <TextBlock Name="CardLossRate" Text="0%" FontSize="28" FontWeight="Bold" Foreground="#1f2937"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="状态变更" Foreground="#6b7280" FontSize="12"/>
                                        <TextBlock Name="CardStatusChanges" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1f2937"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="RTT 趋势" FontSize="14" FontWeight="SemiBold" Foreground="#1f2937" Margin="0,0,0,8"/>
                                    <oxy:PlotView Name="OverviewChart" Height="200" Background="White"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="最近状态变更" FontSize="14" FontWeight="SemiBold" Foreground="#1f2937" Margin="0,0,0,8"/>
                                    <DataGrid Name="OverviewStatusGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#e5e7eb" RowBackground="White" AlternatingRowBackground="#f9fafb" FontSize="12" MaxHeight="200">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="160"/>
                                            <DataGridTextColumn Header="主机" Binding="{Binding Hostname}" Width="180"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Name="OverviewEmptyText" Text="所选范围内无状态变更记录" Foreground="#9ca3af" FontSize="13" HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="趋势" FontSize="14" Padding="16,12">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="分桶" FontSize="13" VerticalAlignment="Center" Foreground="#4b5563" Margin="0,0,8,0"/>
                            <ComboBox Name="BucketSizeSelector" SelectedIndex="2" Width="100" SelectionChanged="BucketSizeSelector_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="10 分钟"/>
                                <ComboBoxItem Content="30 分钟"/>
                                <ComboBoxItem Content="1 小时"/>
                                <ComboBoxItem Content="6 小时"/>
                                <ComboBoxItem Content="1 天"/>
                            </ComboBox>
                            <TextBlock Text="图表" FontSize="13" VerticalAlignment="Center" Foreground="#4b5563" Margin="24,0,8,0"/>
                            <ComboBox Name="ChartTypeSelector" SelectedIndex="1" Width="100" SelectionChanged="ChartTypeSelector_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="折线"/>
                                <ComboBoxItem Content="面积"/>
                                <ComboBoxItem Content="柱状"/>
                            </ComboBox>
                        </StackPanel>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                            <oxy:PlotView Name="TrendsChart" Background="White"/>
                        </Border>

                        <TextBlock Grid.Row="2" Text="状态时间线" FontSize="14" FontWeight="SemiBold" Foreground="#1f2937" Margin="0,0,0,8"/>
                        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="8">
                            <oxy:PlotView Name="StatusTimelineChart" Background="White"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="记录" FontSize="14" Padding="16,12">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="搜索" FontSize="13" VerticalAlignment="Center" Foreground="#4b5563" Margin="0,0,8,0"/>
                            <TextBox Name="SearchBox" Width="300" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Name="RecordsCountText" Text="" FontSize="12" Foreground="#9ca3af" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </DockPanel>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4">
                            <DataGrid Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#f9fafb" FontSize="12" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" EnableRowVirtualization="True">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding RttParsed, Converter={StaticResource RttToColorConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RttParsed}" Value="{x:Null}">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3b82f6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="160"/>
                                    <DataGridTextColumn Header="主机" Binding="{Binding Hostname}" Width="160"/>
                                    <DataGridTextColumn Header="内容" Binding="{Binding Output}" Width="*"/>
                                    <DataGridTextColumn Header="延迟" Binding="{Binding RttDisplay}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                            <Button Name="PrevPageButton" Content="上一页" Click="PrevPageButton_Click" Style="{StaticResource ButtonDefault}" Padding="16,6" Margin="0,0,8,0"/>
                            <TextBlock Name="PageInfoText" Text="1 / 1" VerticalAlignment="Center" FontSize="13" Foreground="#4b5563" Margin="8,0"/>
                            <Button Name="NextPageButton" Content="下一页" Click="NextPageButton_Click" Style="{StaticResource ButtonDefault}" Padding="16,6" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="4,4,4,4" Margin="0,8,0,0">
                            <DataGrid Name="RecordsStatusGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#f9fafb" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="160"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="统计" FontSize="14" Padding="16,12">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="StatsSummaryText" Text="" FontSize="13" Foreground="#4b5563"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4">
                            <DataGrid Name="StatsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#f9fafb" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="主机" Binding="{Binding Hostname}" Width="160"/>
                                    <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="120"/>
                                    <DataGridTextColumn Header="记录数" Binding="{Binding TotalPings}" Width="80"/>
                                    <DataGridTextColumn Header="最小延迟" Binding="{Binding MinRtt}" Width="80"/>
                                    <DataGridTextColumn Header="最大延迟" Binding="{Binding MaxRtt}" Width="80"/>
                                    <DataGridTextColumn Header="平均延迟" Binding="{Binding AvgRtt, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="丢包率" Binding="{Binding LossRate, StringFormat={}{0:F2}%}" Width="80"/>
                                    <DataGridTextColumn Header="最后活动" Binding="{Binding LastActivity}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
